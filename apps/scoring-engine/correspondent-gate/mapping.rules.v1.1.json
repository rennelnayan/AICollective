  "status": "HACKATHON_SYNTHETIC_APPROVED",
  "supersedes": "mapping.rules.v1.1.json",
  "change_summary": [
    "Adds an exact F5 mapping for CBDDQ question 19 = YES so the HP-HIGH-G3 dataset produces a traceable F5 anchor.",
    "Replaces the broad F2 not-equal fallback with explicit ACTIVE and AML-supervisory-action rules.",
    "Preserves the engine-native factor_rules, control_rules, operator, and evidence-tier structure consumed by mapper.mjs.",
    "Retains deterministic highest-matching-anchor-wins behavior."
  ],
  "_note": "Hackathon synthetic mapping rules. Rules key on question_or_field_id exactly as the exhaustive source register emits them. Highest matching anchor per factor wins. This file is compatible with mapper.mjs.",
  "factor_rules": {
    "F1": [
      {
        "rule_id": "F1-R1",
        "workbook": "CBDDQ",
        "field": "2",
        "op": "in",
        "values": [
          "United Kingdom",
          "United States",
          "Germany",
          "France",
          "Singapore",
          "Switzerland",
          "Japan",
          "Canada",
          "Australia"
        ],
        "anchor": 0,
        "basis": "Jurisdiction of incorporation is in the maintained synthetic member list"
      },
      {
        "rule_id": "F1-R2",
        "workbook": "CBDDQ",
        "field": "2",
        "op": "not_in",
        "values": [
          "United Kingdom",
          "United States",
          "Germany",
          "France",
          "Singapore",
          "Switzerland",
          "Japan",
          "Canada",
          "Australia"
