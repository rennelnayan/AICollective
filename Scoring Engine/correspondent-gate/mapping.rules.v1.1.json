{
  "mapping_version": "1.1.0",
  "risk_model_version": "0.1",
  "_note": "Closes EXC-0001. Rules key on question_or_field_id exactly as the exhaustive source register emits them, so no workbook change is required. Each rule names the source party, the condition, and the anchor it sets. Highest matching anchor per factor wins.",
  "factor_rules": {
    "F1": [
      {"rule_id": "F1-R1", "workbook": "CBDDQ", "field": "2", "op": "in",
       "values": ["United Kingdom", "United States", "Germany", "France", "Singapore", "Switzerland", "Japan", "Canada", "Australia"],
       "anchor": 0, "basis": "FATF member jurisdiction of incorporation"},
      {"rule_id": "F1-R2", "workbook": "CBDDQ", "field": "2", "op": "not_in",
       "values": ["United Kingdom", "United States", "Germany", "France", "Singapore", "Switzerland", "Japan", "Canada", "Australia"],
       "anchor": 6, "basis": "Jurisdiction outside the maintained FATF member list"}
    ],
    "F2": [
      {"rule_id": "F2-R1", "workbook": "CBDDQ", "field": "13", "op": "eq", "values": ["ACTIVE"],
       "anchor": 0, "basis": "Banking licence active and regulator named"},
      {"rule_id": "F2-R2", "workbook": "CBDDQ", "field": "13", "op": "ne", "values": ["ACTIVE"],
       "anchor": 10, "basis": "Licence not active or not stated"}
    ],
    "F3": [
      {"rule_id": "F3-R1", "workbook": "CBDDQ", "field": "16", "op": "eq", "values": ["YES"],
       "anchor": 10, "basis": "Bearer shares in issue, FATF Rec 33"},
      {"rule_id": "F3-R2", "workbook": "CBDDQ", "field": "6", "op": "eq", "values": ["YES"],
       "anchor": 0, "basis": "Publicly traded, FATF IN Rec 5 para 10"},
      {"rule_id": "F3-R3", "workbook": "CBDDQ", "field": "6", "op": "eq", "values": ["NO"],
       "anchor": 3, "basis": "Privately held with parent disclosed and no bearer shares"}
    ],
    "F4": [
      {"rule_id": "F4-R1", "workbook": "CBDDQ", "field": "18", "op": "eq", "values": ["YES"],
       "anchor": 10, "basis": "Shell bank asserted, FATF Rec 18 hard exclusion also fires"},
      {"rule_id": "F4-R2", "workbook": "CBDDQ", "field": "17", "op": "eq", "values": ["YES"],
       "anchor": 0, "basis": "Physical presence asserted and not a shell bank"},
      {"rule_id": "F4-R3", "workbook": "CBDDQ", "field": "17", "op": "eq", "values": ["NO"],
       "anchor": 10, "basis": "No physical presence"}
    ],
    "F5": [
      {"rule_id": "F5-R1", "workbook": "CBDDQ", "field": "20", "op": "eq", "values": ["YES"],
       "anchor": 10, "basis": "Payable-through accounts offered, FATF Rec 7(e)"},
      {"rule_id": "F5-R2", "workbook": "CBDDQ", "field": "19a", "op": "eq", "values": ["YES"],
       "anchor": 6, "basis": "Nested relationships offered"},
      {"rule_id": "F5-R3", "workbook": "CBDDQ", "field": "19", "op": "eq", "values": ["NO"],
       "anchor": 3, "basis": "Respondent banks not permitted to use the account"}
    ],
    "F6": [
      {"rule_id": "F6-R1", "workbook": "RELATIONSHIP_SCOPING", "field": "S23", "op": "contains",
       "values": ["Regulated corporate and institutional"],
       "anchor": 3, "basis": "Regulated corporate and institutional customer base"},
      {"rule_id": "F6-R2", "workbook": "RELATIONSHIP_SCOPING", "field": "S23", "op": "not_contains",
       "values": ["Regulated corporate and institutional"],
       "anchor": 6, "basis": "Customer base not limited to regulated counterparties"}
    ]
  },
  "control_rules": {
